@model Web_hoaqua.Models.User
@{
	ViewData["Title"] = "Tài khoản của tôi";
}

<div class="container mt-5 mb-5">
	<div class="row">
		<div class="col-md-3">
			<div class="card">
				<div class="card-body">
					<h5 class="card-title mb-3">Quản lý tài khoản</h5>
					<ul class="list-unstyled">
						<li class="mb-2"><a href="@Url.Action("Index","Account")" class="text-decoration-none">Hồ sơ cá nhân</a></li>
						<li class="mb-2"><a href="@Url.Action("EditProfile","Account")" class="text-decoration-none">Chỉnh sửa thông tin</a></li>
						<li class="mb-2"><a href="@Url.Action("ChangePassword","Account")" class="text-decoration-none">Đổi mật khẩu</a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="col-md-9">
			<div class="card">
				<div class="card-header bg-success text-white">
					<h4 class="mb-0">Hồ sơ cá nhân</h4>
				</div>
				<div class="card-body">
					<p><strong>Tên:</strong> @Model.FullName</p>
					<p><strong>Email:</strong> @Model.Email</p>
					<p><strong>SĐT:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</p>
				</div>
			</div>
		</div>
	</div>
</div>
