@model RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-container">
    <div class="login-box">
        <h2 class="login-title">Đăng Ký Tài Khoản</h2>
        
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Register" asp-controller="Home" method="post" id="registerForm" novalidate>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Họ và Tên</label>
                <input asp-for="FullName" 
                     class="form-control" 
                     placeholder="Nhập họ và tên"
                     required>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" 
                     class="form-control" 
                     placeholder="Nhập email của bạn"
                     required>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                <input asp-for="Phone" 
                     class="form-control" 
                     placeholder="Nhập số điện thoại">
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <input asp-for="Password" 
                         type="password"
                         class="form-control" 
                         placeholder="Nhập mật khẩu"
                         required>
                    <button class="btn btn-outline-secondary toggle-password" type="button" aria-label="Hiện/ẩn mật khẩu">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small d-block"></span>
                <ul class="list-unstyled small mt-2 mb-0" id="passwordChecklist">
                    <li data-rule="length" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 12 ký tự</li>
                    <li data-rule="upper" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 chữ cái viết hoa (A-Z)</li>
                    <li data-rule="lower" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 chữ cái viết thường (a-z)</li>
                    <li data-rule="digit" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 chữ số (0-9)</li>
                    <li data-rule="special" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 ký tự đặc biệt (!&#64;#$%^&amp;*)</li>
                    <li data-rule="unique" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 4 ký tự khác nhau</li>
                </ul>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Xác Nhận Mật Khẩu</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" 
                         type="password"
                         class="form-control" 
                         placeholder="Nhập lại mật khẩu"
                         required>
                    <button class="btn btn-outline-secondary toggle-password" type="button" aria-label="Hiện/ẩn xác nhận mật khẩu">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block"></span>
            </div>

            <button type="submit" class="btn btn-login w-100" id="btnRegister">Đăng Ký</button>

            <div class="login-footer">
                <p>Đã có tài khoản? <a href="@Url.Action("Login", "Home")">Đăng nhập ngay</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registerForm');
            const btn = document.getElementById('btnRegister');

            document.querySelectorAll('.toggle-password').forEach(function(toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    const input = this.closest('.input-group').querySelector('input');
                    const icon = this.querySelector('i');
                    const isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    icon.classList.toggle('fa-eye', !isHidden);
                    icon.classList.toggle('fa-eye-slash', isHidden);
                });
            });

            const passwordInput = document.getElementById('Password');
            const checklistItems = document.querySelectorAll('#passwordChecklist li');

            function updatePasswordChecklist() {
                const val = passwordInput.value || '';
                const rules = {
                    length: val.length >= 12,
                    upper: /[A-Z]/.test(val),
                    lower: /[a-z]/.test(val),
                    digit: /[0-9]/.test(val),
                    special: /[^A-Za-z0-9]/.test(val),
                    unique: new Set(val).size >= 4
                };

                checklistItems.forEach(function(item) {
                    const rule = item.getAttribute('data-rule');
                    const icon = item.querySelector('i');
                    if (val.length === 0) {
                        item.className = 'text-muted';
                        icon.className = 'fas fa-circle me-1';
                    } else if (rules[rule]) {
                        item.className = 'text-success';
                        icon.className = 'fas fa-check-circle me-1';
                    } else {
                        item.className = 'text-danger';
                        icon.className = 'fas fa-times-circle me-1';
                    }
                });
            }

            if (passwordInput) {
                passwordInput.addEventListener('input', updatePasswordChecklist);
                updatePasswordChecklist();
            }

            form.addEventListener('submit', function() {
                if ($(form).valid()) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';
                }
            });
        });
    </script>
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        padding: 20px;
    }

    .login-box {
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 400px;
    }

    .login-title {
        text-align: center;
        color: #333;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .form-label {
        color: #555;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 5px;
        padding: 10px 12px;
        font-size: 14px;
    }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
    }

    .btn-login {
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 10px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(25, 135, 84, 0.4);
        color: white;
    }

    .login-footer {
        text-align: center;
        margin-top: 20px;
        color: #666;
        font-size: 14px;
    }

    .login-footer a {
        color: #198754;
        text-decoration: none;
        font-weight: 600;
    }

    .login-footer a:hover {
        text-decoration: underline;
    }
</style>
