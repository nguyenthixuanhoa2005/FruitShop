@model FruitShop.Models.SecurityIncident
@{
    ViewData["Title"] = "Báo cáo sự cố bảo mật";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fas fa-shield-alt fa-lg"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">Báo Cáo Sự Cố Bảo Mật</h3>
                        <p class="text-muted small mb-0">Gửi thông tin sự cố nghi ngờ (lộ tài khoản, lừa đảo, lỗi bảo mật...) tới đầu mối ATTT</p>
                    </div>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="ReportIncident" asp-controller="Home" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-bold small text-muted">Người báo cáo / Email</label>
                            <input asp-for="ReportedBy" class="form-control rounded-3" placeholder="example@gmail.com" required />
                            <span asp-validation-for="ReportedBy" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-muted">Mức độ nghiêm trọng</label>
                            <select asp-for="Severity" class="form-select rounded-3">
                                <option value="Thấp">Thấp (trong 24 giờ)</option>
                                <option value="Trung bình">Trung bình (trong 4 giờ)</option>
                                <option value="Cao">Cao (xử lý ngay lập tức)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">Tiêu đề sự cố</label>
                            <input asp-for="Title" class="form-control rounded-3" placeholder="Ví dụ: Phát hiện email giả mạo / nghi ngờ chiếm quyền tài khoản" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">Mô tả chi tiết</label>
                            <textarea asp-for="Description" rows="5" class="form-control rounded-3" placeholder="Mô tả thời điểm phát hiện, dấu hiệu bất thường, đường dẫn hoặc tài khoản liên quan..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                            <i class="fas fa-paper-plane me-2"></i>Gửi báo cáo sự cố
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">Quay lại</a>
                    </div>
                </form>
            </div>

            @{
                var myIncidents = ViewBag.MyIncidents as List<FruitShop.Models.SecurityIncident>;
            }
            @if (myIncidents != null && myIncidents.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-history text-success me-2"></i>Trạng thái &amp; Phản hồi từ Quản trị viên
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-muted text-uppercase">
                                    <th>Thời gian</th>
                                    <th>Sự cố</th>
                                    <th>Mức độ</th>
                                    <th>Trạng thái</th>
                                    <th>Biện pháp / Hướng dẫn từ Admin</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in myIncidents)
                                {
                                    var sevBadge = item.Severity switch
                                    {
                                        "Cao" => "bg-danger",
                                        "Trung bình" => "bg-warning text-dark",
                                        _ => "bg-info text-dark"
                                    };
                                    var stBadge = item.Status switch
                                    {
                                        "Đã đóng" => "bg-success",
                                        "Đã ngăn chặn" => "bg-primary",
                                        "Đang xử lý" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <div class="fw-semibold">@item.Title</div>
                                            <div class="small text-muted">@item.Description</div>
                                        </td>
                                        <td><span class="badge @sevBadge">@item.Severity</span></td>
                                        <td><span class="badge @stBadge">@item.Status</span></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.ResolutionNote))
                                            {
                                                <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success small fw-semibold">
                                                    @item.ResolutionNote
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="small text-muted fst-italic">Đang chờ đầu mối ATTT phản hồi...</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
