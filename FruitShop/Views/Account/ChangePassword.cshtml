@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                        @(Context.Session.GetString("UserName")?.Substring(0, 1) ?? "U")
                    </div>
                    <h5 class="fw-bold mb-0">@Context.Session.GetString("UserName")</h5>
                    <p class="text-muted small">@Context.Session.GetString("UserEmail")</p>
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" class="list-group-item list-group-item-action border-0 py-3 rounded-3 mb-2">
                        <i class="fas fa-user me-2"></i>Thông tin cá nhân
                    </a>
                    <a asp-action="EditProfile" class="list-group-item list-group-item-action border-0 py-3 rounded-3 mb-2">
                        <i class="fas fa-user-edit me-2"></i>Chỉnh sửa hồ sơ
                    </a>
                    <a asp-action="ChangePassword" class="list-group-item list-group-item-action border-0 py-3 active rounded-3 mb-2">
                        <i class="fas fa-key me-2"></i>Đổi mật khẩu
                    </a>
                    <a asp-controller="Orders" asp-action="Index" class="list-group-item list-group-item-action border-0 py-3 rounded-3">
                        <i class="fas fa-shopping-bag me-2"></i>Đơn hàng của tôi
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold mb-4">Đổi mật khẩu</h4>
                
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div id="clientPasswordError" class="alert alert-danger d-none mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">Mật khẩu hiện tại</label>
                            <div class="input-group">
                                <input type="password" name="currentPassword" class="form-control rounded-start-3" placeholder="Nhập mật khẩu hiện tại" required>
                                <button class="btn btn-outline-secondary toggle-password" type="button" aria-label="Hiện/ẩn mật khẩu hiện tại">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">Mật khẩu mới</label>
                            <div class="input-group">
                                <input type="password" id="newPassword" name="newPassword" class="form-control rounded-start-3" placeholder="Nhập mật khẩu mới" required>
                                <button class="btn btn-outline-secondary toggle-password" type="button" aria-label="Hiện/ẩn mật khẩu mới">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <ul class="list-unstyled small mt-2 mb-0" id="passwordChecklist">
                                <li data-rule="length" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 12 ký tự</li>
                                <li data-rule="upper" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 chữ cái viết hoa (A-Z)</li>
                                <li data-rule="lower" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 chữ cái viết thường (a-z)</li>
                                <li data-rule="digit" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 chữ số (0-9)</li>
                                <li data-rule="special" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 1 ký tự đặc biệt (!&#64;#$%^&amp;*)</li>
                                <li data-rule="unique" class="text-muted"><i class="fas fa-circle me-1"></i> Ít nhất 4 ký tự khác nhau</li>
                            </ul>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">Xác nhận mật khẩu mới</label>
                            <div class="input-group">
                                <input type="password" name="confirmPassword" class="form-control rounded-start-3" placeholder="Nhập lại mật khẩu mới" required>
                                <button class="btn btn-outline-secondary toggle-password" type="button" aria-label="Hiện/ẩn xác nhận mật khẩu mới">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Cập nhật mật khẩu</button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-password').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const input = this.closest('.input-group').querySelector('input');
                const icon = this.querySelector('i');
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                icon.classList.toggle('fa-eye', !isHidden);
                icon.classList.toggle('fa-eye-slash', isHidden);
            });
        });

        const newPasswordInput = document.getElementById('newPassword');
        const checklistItems = document.querySelectorAll('#passwordChecklist li');

        function updatePasswordChecklist() {
            const val = newPasswordInput.value || '';
            const rules = {
                length: val.length >= 12,
                upper: /[A-Z]/.test(val),
                lower: /[a-z]/.test(val),
                digit: /[0-9]/.test(val),
                special: /[^A-Za-z0-9]/.test(val),
                unique: new Set(val).size >= 4
            };

            checklistItems.forEach(function (item) {
                const rule = item.getAttribute('data-rule');
                const icon = item.querySelector('i');
                if (val.length === 0) {
                    item.className = 'text-muted';
                    icon.className = 'fas fa-circle me-1';
                } else if (rules[rule]) {
                    item.className = 'text-success';
                    icon.className = 'fas fa-check-circle me-1';
                } else {
                    item.className = 'text-danger';
                    icon.className = 'fas fa-times-circle me-1';
                }
            });
        }

        if (newPasswordInput) {
            newPasswordInput.addEventListener('input', updatePasswordChecklist);
            updatePasswordChecklist();
        }

        const changePasswordForm = document.querySelector('form[asp-action="ChangePassword"], form[action*="ChangePassword"]');
        const confirmPasswordInput = document.querySelector('input[name="confirmPassword"]');
        const clientErrorBox = document.getElementById('clientPasswordError');

        if (changePasswordForm && newPasswordInput) {
            changePasswordForm.addEventListener('submit', function (e) {
                const val = newPasswordInput.value || '';
                const confirmVal = confirmPasswordInput ? confirmPasswordInput.value : '';
                const isStrong = val.length >= 12
                    && /[A-Z]/.test(val)
                    && /[a-z]/.test(val)
                    && /[0-9]/.test(val)
                    && /[^A-Za-z0-9]/.test(val)
                    && new Set(val).size >= 4;

                if (!isStrong) {
                    e.preventDefault();
                    updatePasswordChecklist();
                    if (clientErrorBox) {
                        clientErrorBox.textContent = 'Mật khẩu mới chưa đạt đủ 6 điều kiện bảo mật bên dưới.';
                        clientErrorBox.classList.remove('d-none');
                    }
                    newPasswordInput.focus();
                    return;
                }

                if (val !== confirmVal) {
                    e.preventDefault();
                    if (clientErrorBox) {
                        clientErrorBox.textContent = 'Mật khẩu xác nhận không khớp.';
                        clientErrorBox.classList.remove('d-none');
                    }
                    if (confirmPasswordInput) confirmPasswordInput.focus();
                    return;
                }

                if (clientErrorBox) {
                    clientErrorBox.classList.add('d-none');
                }
            });
        }
    </script>
}
